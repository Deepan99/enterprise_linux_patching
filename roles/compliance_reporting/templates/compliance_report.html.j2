<!DOCTYPE html>
<html>
<head>
  <title>Enterprise Linux Patching - Compliance Report</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h1 { color: #2c3e50; }
    h2 { color: #34495e; }
    table { border-collapse: collapse; width: 100%; margin: 20px 0; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background-color: #3498db; color: white; }
    tr:nth-child(even) { background-color: #f2f2f2; }
    .pass { color: green; font-weight: bold; }
    .fail { color: red; font-weight: bold; }
    .summary { background-color: #ecf0f1; padding: 15px; border-radius: 5px; }
  </style>
</head>
<body>
  <h1>Enterprise Linux Patching - Compliance Report</h1>
  <div class="summary">
    <p><strong>Report ID:</strong> {{ report_metadata.report_id }}</p>
    <p><strong>Generated At:</strong> {{ report_metadata.generated_at }}</p>
    <p><strong>Generated By:</strong> {{ report_metadata.generated_by }}</p>
    <p><strong>Total Hosts:</strong> {{ groups['linux_servers'] | default([]) | length }}</p>
    <p><strong>Validated Hosts:</strong> {{ validation_files.matched }}</p>
  </div>

  <h2>Validation Results</h2>
  <table>
    <tr>
      <th>Hostname</th>
      <th>Validation Type</th>
      <th>Status</th>
      <th>Details</th>
    </tr>
    {% for item in validation_data %}
    <tr>
      <td>{{ item.hostname }}</td>
      <td>{{ 'Pre-Validation' if '_pre' in item.validation_file else 'Post-Validation' }}</td>
      <td class="{{ 'pass' if 'PASS' in item.validation_result else 'fail' }}">
        {{ 'PASS' if 'PASS' in item.validation_result else 'FAIL' }}
      </td>
      <td>{{ item.validation_result | truncate(100, True) }}</td>
    </tr>
    {% endfor %}
  </table>

  <h2>Compliance Standards</h2>
  <ul>
    {% for standard in compliance_standards %}
    <li>{{ standard }}</li>
    {% endfor %}
  </ul>

  <h2>Audit Trail</h2>
  <ul>
    <li>Validation checks performed: Yes</li>
    <li>Approval workflow enabled: Yes</li>
    <li>Rollback capability verified: Yes</li>
    <li>Compliance logging: Enabled</li>
  </ul>
</body>
</html>
